---
interface Swatch {
  label: string;
  token: string;
  ink?: string;
  accent?: "accent" | "secondary" | "tertiary" | "success" | "warning" | "danger";
}

interface Props {
  label?: string;
  items: readonly Swatch[];
  accent?: Swatch["accent"];
}

const { label, items, accent } = Astro.props;
---

<ul class="sg-swatch-grid" aria-label={label} data-accent={accent}>
  {items.map((item) => (
    <li>
      <figure class="sg-swatch" data-accent={item.accent}>
        <div data-swatch={item.token.endsWith("border") ? "border" : item.token.endsWith("text") || item.token === "--muted" ? "text" : "fill"}
          style={`--sg-color:var(${item.token})${item.ink ? `;--sg-ink:var(${item.ink})` : ""}`}>
          {(item.ink || item.token.endsWith("text") || item.token === "--muted") && <span aria-hidden="true">Aa</span>}
        </div>
        <figcaption>{item.label}<code>{item.token}</code></figcaption>
      </figure>
    </li>
  ))}
</ul>
