---
interface Props {
  id: string;
  title: string;
  api: string;
}

const { id, title, api } = Astro.props;
---

<section data-scrub id={id}>
  <div class="c lg">
    <div g="3-1">
      <div class="section-name-wrap">
        <div class="s section-name-sticky">
          <div class="sg-heading-wrap">
            <h2 class="lead">{title}</h2>
          </div>
          <div class="s">
            <slot name="summary" />
            <code>{api}</code>
          </div>
        </div>
      </div>
      <div class="s section-content-wrap" c="2-0">
        <slot />
      </div>
    </div>
  </div>
</section>
