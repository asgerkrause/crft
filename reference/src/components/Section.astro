---
interface Props {
  id: string;
  title: string;
  api: string;
}

const { id, title, api } = Astro.props;
---

<section data-scrub id={id}>
  <div c="lg">
    <div g="3-1">
      <div class="section-name-wrap">
        <div class="section-name-sticky" s>
          <div class="sg-heading-wrap">
            <h2 t="lg">{title}</h2>
          </div>
          <div s>
            <slot name="summary" />
            <code>{api}</code>
          </div>
        </div>
      </div>
      <div class="section-content-wrap" s x="2-0">
        <slot />
      </div>
    </div>
  </div>
</section>
