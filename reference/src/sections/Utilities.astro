---
import Section from "../components/Section.astro";
import Specimen from "../components/Specimen.astro";
import { sections } from "../data";
---

<Section {...sections.utilities}>
  <p slot="summary">Assistive recovery stays a finite utility. Typography uses semantic roles and project CSS.</p>

  <Specimen id="accessible-content" title="Accessible content">
    <p><span class="sr">Screen-reader-only context: </span><a class="sr focusable" href="#utilities">Skip to
        utility
        specimens</a><code>.sr</code> remains available to assistive technology; <code>.sr.focusable</code>
      returns
      on keyboard focus.</p>
  </Specimen>

  <Specimen id="corner-shape" title="Corner shape">
    <label>Opt-in corner <input class="squircle" data-fixture="progressive-corner" value="Squircle where supported" readonly></label>
  </Specimen>
</Section>
