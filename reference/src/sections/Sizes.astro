---
import Section from "../components/Section.astro";
import { sections } from "../data";

const scaleFamilies = [
  { id: "spacing", title: "Spacing", prefix: "space", boxClass: "sg-measure", property: "--sg-size", ratio: "--space-ratio", anchor: "--space" },
  { id: "gap", title: "Gap", prefix: "gap", boxClass: "sg-gap-box", property: "gap", ratio: "--gap-ratio", anchor: "--gap" },
  { id: "padding", title: "Padding", prefix: "padding", boxClass: "sg-padding-box", property: "padding", ratio: "--padding-ratio", anchor: "--padding" },
  { id: "radius", title: "Radius", prefix: "radius", boxClass: "sg-radius-box", property: "border-radius", ratio: "--radius-ratio", anchor: "--radius" },
] as const;

const variants = ["xs", "sm", "", "lg", "xl"] as const;
---

<Section {...sections.sizes}>
  <p slot="summary" class="sg-note">These rows show the public scale families. Their values and responsive formulas remain in the token source.</p>

  {scaleFamilies.map((family) => (
    <article id={family.id} class="s sg-scale-family">
      <header>
        <div class="sg-heading-wrap">
          <h3>{family.title}</h3>
        </div>
        <p><code>{family.ratio}</code> ratio · <code>{family.anchor}</code> anchor</p>
      </header>
      {family.id === "spacing" && <p class="small">Bars show actual lengths on one shared scale. Scroll the comparison if the longest bar exceeds the available width.</p>}
      <div class="sg-measure-ramp">
        {variants.map((variant) => {
          const token = `--${family.prefix}${variant ? `-${variant}` : ""}`;
          const style = `${family.property}:var(${token})`;

          return (
            <div class={family.boxClass} style={style}>
              <i></i>
              {family.id === "gap" && <i></i>}
              <code>{token}</code>
            </div>
          );
        })}
      </div>
    </article>
  ))}
</Section>
