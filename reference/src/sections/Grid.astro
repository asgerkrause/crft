---
import Section from "../components/Section.astro";
import Specimen from "../components/Specimen.astro";
import { sections } from "../data";
---

<Section {...sections.grid}>
  <p slot="summary" class="sg-note">Grid attributes apply to a grid and its direct children. Without a named container numbered grids
    remain a flex column; source order must remain meaningful.</p>

  <section>
  <div class="c s">
  <Specimen id="columns-and-spans" title="Columns and spans">
    <p class="small">These grids query this specimen column's width: stacked below 30rem, medium from 30rem, large from 60rem. Resize to compare.</p>
    <div class="sg-grid-list">
      <div>
        <div class="sg-specimen-label"><code>g</code><span>default grid</span></div>
        <div g><span>One</span><span>Two</span><span>Three</span></div>
      </div>
      <div>
        <div class="sg-specimen-label"><code>g="8-4" + c="4-2"</code><span>responsive span</span></div>
        <div g="8-4"><span c="4-2">Featured</span><span>Default</span><span>Default</span></div>
      </div>
      <div>
        <div class="sg-specimen-label"><code>c="0"</code><span>full row</span></div>
        <div g="4-2"><span c="0">Full row</span><span>Two</span><span>Three</span></div>
      </div>
      <div>
        <div class="sg-specimen-label"><code>r="2-1"</code><span>controlled row span</span></div>
        <div g="3"><span r="2-1">Row span</span><span>Two</span><span>Three</span><span>Four</span></div>
      </div>
    </div>
  </Specimen>

  <Specimen id="container-boundaries" title="Container boundaries">
    <p class="small">Each grid queries its own <code>section &gt; .c</code>. This comparison sets <code>--content-max: 36rem</code>.</p>
    <div class="sg-grid-list sg-grid-boundaries">
      <section data-fixture="grid-boundary-sm">
        <p class="sg-specimen-label"><code>.c.sm</code> · 24rem cap · below the grid threshold</p>
        <div class="c sm"><div g="3" data-fixture="grid-sm"><span>One</span><span>Two</span><span>Three</span></div></div>
      </section>
      <section data-fixture="grid-boundary-default">
        <p class="sg-specimen-label"><code>.c</code> · 36rem cap</p>
        <div class="c"><div g="3" data-fixture="grid-default"><span>One</span><span>Two</span><span>Three</span></div></div>
      </section>
      <section data-fixture="grid-boundary-lg">
        <p class="sg-specimen-label"><code>.c.lg</code> · 48rem cap</p>
        <div class="c lg"><div g="3" data-fixture="grid-lg"><span>One</span><span>Two</span><span>Three</span></div></div>
      </section>
      <section data-fixture="grid-boundary-nested">
        <p class="sg-specimen-label">Nested grid · the inner container decides independently</p>
        <div class="c"><div g="2" data-fixture="grid-nested-outer"><span>Outer</span><section data-fixture="grid-boundary-nested-inner"><div class="c"><div g="2" data-fixture="grid-nested-inner"><span>Inner one</span><span>Inner two</span></div></div></section></div></div>
      </section>
    </div>
  </Specimen>

  <Specimen id="visual-order" title="Visual order">
    <div class="sg-grid-list">
      <div>
        <div class="sg-specimen-label"><code>o="f-a-l"</code><span>visual order only</span></div>
        <div g="3"><span o="f-a-l">Ordered first / auto / last</span><span>Two</span><span>Three</span></div>
      </div>
    </div>
  </Specimen>

  <Specimen id="visual-order-focus" title="Visual order and focus">
    <p class="small">Visual order changes presentation, never DOM or keyboard order.</p>
    <div g="3" data-fixture="visual-order-focus">
      <a href="#visual-order-focus" data-fixture="visual-order-first" o="l-a-f">First in source</a>
      <a href="#visual-order-focus" data-fixture="visual-order-second" o="f-a-a">Second in source</a>
      <a href="#visual-order-focus" data-fixture="visual-order-third" o="a-a-l">Third in source</a>
    </div>
  </Specimen>

  <Specimen id="intrinsic-grid" title="Intrinsic fit and fill">
    <p class="small">One item in each grid. Fill retains empty tracks when room permits; compare the same minimum track sizes with fit below.</p>
    <div class="sg-grid-list">
      <div>
        <div class="sg-specimen-label"><code>g="fill-sm"</code><span>compact auto-fill</span></div>
        <div g="fill-sm"><span>One item</span></div>
      </div>
      <div>
        <div class="sg-specimen-label"><code>g="fill"</code><span>general auto-fill</span></div>
        <div g="fill"><span>One item</span></div>
      </div>
      <div>
        <div class="sg-specimen-label"><code>g="fill-lg"</code><span>spacious auto-fill</span></div>
        <div g="fill-lg"><span>One item</span></div>
      </div>
    </div>
  </Specimen>

  <Specimen id="fit-grids" title="Fit collapses empty tracks">
    <div class="sg-grid-list">
      <div>
        <div class="sg-specimen-label"><code>g="fit-sm"</code><span>compact auto-fit</span></div>
        <div g="fit-sm"><span>One item</span></div>
      </div>
      <div>
        <div class="sg-specimen-label"><code>g="fit"</code><span>general auto-fit</span></div>
        <div g="fit"><span>One item</span></div>
      </div>
      <div>
        <div class="sg-specimen-label"><code>g="fit-lg"</code><span>spacious auto-fit</span></div>
        <div g="fit-lg"><span>One item</span></div>
      </div>
    </div>
  </Specimen>

  <Specimen id="subgrid" title="Subgrid">
    <div class="sg-grid-list">
      <div>
        <div class="sg-specimen-label"><code>g="sg"</code><span>nested subgrid</span></div>
        <div g="3"><span>One</span><span g="sg" c="2"><i>Nested one</i><i>Nested two</i></span></div>
      </div>
    </div>
  </Specimen>
  </div>
  </section>
</Section>

<section id="grid-no-container" data-fixture="grid-no-container">
  <div class="sg-grid-list">
    <div>
      <div class="sg-specimen-label"><code>g="3"</code><span>no container fallback</span></div>
      <div g="3" data-fixture="grid-no-container-grid"><span>One</span><span>Two</span><span>Three</span></div>
    </div>
  </div>
</section>
