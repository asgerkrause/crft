---
import Section from "../components/Section.astro";
import Specimen from "../components/Specimen.astro";
import { sections } from "../data";
---

<Section {...sections.grid}>
  <p t="mu" slot="summary">Grid attributes apply to a grid and its direct children. On small screens every grid
    becomes a flex column; source order must remain meaningful.</p>

  <Specimen id="columns-and-spans" title="Columns and spans">
    <div class="sg-grid-list">
      <div>
        <div class="sg-specimen-label"><code>g</code><span>default grid</span></div>
        <div g><span>One</span><span>Two</span><span>Three</span></div>
      </div>
      <div>
        <div class="sg-specimen-label"><code>g="8-4" + x="4-2"</code><span>responsive span</span></div>
        <div g="8-4"><span x="4-2">Featured</span><span>Default</span><span>Default</span></div>
      </div>
      <div>
        <div class="sg-specimen-label"><code>x="0"</code><span>full row</span></div>
        <div g="4-2"><span x="0">Full row</span><span>Two</span><span>Three</span></div>
      </div>
      <div>
        <div class="sg-specimen-label"><code>y="2-1"</code><span>controlled row span</span></div>
        <div g="3"><span y="2-1">Row span</span><span>Two</span><span>Three</span><span>Four</span></div>
      </div>
    </div>
  </Specimen>

  <Specimen id="container-boundaries" title="Container boundaries">
    <div class="sg-grid-list">
      <section data-fixture="grid-boundary-sm">
        <div c="sm"><div g="3" data-fixture="grid-sm"><span>One</span><span>Two</span><span>Three</span></div></div>
      </section>
      <section data-fixture="grid-boundary-default">
        <div c><div g="3" data-fixture="grid-default"><span>One</span><span>Two</span><span>Three</span></div></div>
      </section>
      <section data-fixture="grid-boundary-lg">
        <div c="lg"><div g="3" data-fixture="grid-lg"><span>One</span><span>Two</span><span>Three</span></div></div>
      </section>
      <section data-fixture="grid-boundary-nested">
        <div c><div g="2" data-fixture="grid-nested-outer"><span>Outer</span><section data-fixture="grid-boundary-nested-inner"><div c><div g="2" data-fixture="grid-nested-inner"><span>Inner one</span><span>Inner two</span></div></div></section></div></div>
      </section>
    </div>
  </Specimen>

  <Specimen id="visual-order" title="Visual order">
    <div class="sg-grid-list">
      <div>
        <div class="sg-specimen-label"><code>o="f-a-l"</code><span>visual order only</span></div>
        <div g="3"><span o="f-a-l">Ordered first / auto / last</span><span>Two</span><span>Three</span></div>
      </div>
    </div>
  </Specimen>

  <Specimen id="visual-order-focus" title="Visual order and focus">
    <p t="sm">Visual order changes presentation, never DOM or keyboard order.</p>
    <div g="3" data-fixture="visual-order-focus">
      <a href="#visual-order-focus" data-fixture="visual-order-first" o="l-a-f">First in source</a>
      <a href="#visual-order-focus" data-fixture="visual-order-second" o="f-a-a">Second in source</a>
      <a href="#visual-order-focus" data-fixture="visual-order-third" o="a-a-l">Third in source</a>
    </div>
  </Specimen>

  <Specimen id="auto-fit" title="Auto-fit">
    <div class="sg-grid-list">
      <div>
        <div class="sg-specimen-label"><code>g="a-sm"</code><span>compact auto-fit</span></div>
        <div g="a-sm"><span>One</span><span>Two</span><span>Three</span><span>Four</span></div>
      </div>
      <div>
        <div class="sg-specimen-label"><code>g="a"</code><span>general auto-fit</span></div>
        <div g="a"><span>One</span><span>Two</span></div>
      </div>
      <div>
        <div class="sg-specimen-label"><code>g="a-lg"</code><span>spacious auto-fit</span></div>
        <div g="a-lg"><span>One</span><span>Two</span></div>
      </div>
    </div>
  </Specimen>

  <Specimen id="subgrid" title="Subgrid">
    <div class="sg-grid-list">
      <div>
        <div class="sg-specimen-label"><code>g="sg"</code><span>nested subgrid</span></div>
        <div g="3"><span>One</span><span g="sg" x="2"><i>Nested one</i><i>Nested two</i></span></div>
      </div>
    </div>
  </Specimen>
</Section>

<section id="grid-no-container" class="sg-section" data-fixture="grid-no-container">
  <div class="sg-grid-list">
    <div>
      <div class="sg-specimen-label"><code>g="3"</code><span>no container fallback</span></div>
      <div g="3" data-fixture="grid-no-container-grid"><span>One</span><span>Two</span><span>Three</span></div>
    </div>
  </div>
</section>
