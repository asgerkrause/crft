---
import Section from "../components/Section.astro";
import Specimen from "../components/Specimen.astro";
import { sections } from "../data";

const layers = [
  { order: "01", label: "Reset", file: "styles/crft.css" },
  { order: "02", label: "Base", file: "styles/crft.css" },
  { order: "03", label: "Tokens", file: "styles/tokens.css" },
  { order: "04", label: "Type", file: "crft.css; optional faces in tokens.css" },
  { order: "05", label: "Layout", file: "styles/crft.css" },
  { order: "06", label: "Grid", file: "styles/crft.css" },
  { order: "07", label: "Motion", file: "styles/crft.css" },
  { order: "08", label: "Utility", file: "styles/crft.css" },
  { order: "09", label: "Project", file: "consumer-owned CSS" },
] as const;
---

<Section {...sections.architecture}>
  <p slot="summary" class="sg-note">Import <code>styles/global.css</code> once. Three files keep brand tokens and framework behavior separate; eight layer names keep their jobs.</p>

  <Specimen id="layer-order" title="Layer order">
    <ol class="sg-architecture-list">
      {layers.map((layer) => (
        <li><span>{layer.order}</span><strong>{layer.label}</strong><code>{layer.file}</code></li>
      ))}
    </ol>
  </Specimen>

  <Specimen id="public-boundary" title="Public boundary">
    <p class="sg-a11y-note">Public use is limited to documented tokens, selectors, attributes, and native
      guarantees. Runtime implementation state is not consumer API.</p>
  </Specimen>
</Section>
