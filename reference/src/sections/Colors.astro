---
import Section from "../components/Section.astro";
import Specimen from "../components/Specimen.astro";
import Swatches from "../components/Swatches.astro";
import { sections } from "../data";

const palette = [
  { label: "Light", token: "--palette-light", featured: true },
  { label: "Dark", token: "--palette-dark", featured: true },
  { label: "Red", token: "--palette-red" },
  { label: "Orange", token: "--palette-orange" },
  { label: "Yellow", token: "--palette-yellow" },
  { label: "Green", token: "--palette-green" },
  { label: "Blue", token: "--palette-blue" },
  { label: "Purple", token: "--palette-purple" },
] as const;

const theme = [
  { label: "Background", token: "--canvas" },
  { label: "Surface", token: "--surface" },
  { label: "Border", token: "--border" },
  { label: "Foreground", token: "--text" },
  { label: "Muted", token: "--muted" },
  { label: "Accent", token: "--accent", ink: "--on-accent" },
  { label: "Secondary", token: "--secondary", ink: "--on-secondary" },
  { label: "Tertiary", token: "--tertiary", ink: "--on-tertiary" },
  { label: "Success", token: "--success", ink: "--on-success" },
  { label: "Warning", token: "--warning", ink: "--on-warning" },
  { label: "Danger", token: "--danger", ink: "--on-danger" },
] as const;

const accent = [
  { label: "Solid", token: "--accent", ink: "--on-accent", grouped: true },
  { label: "Contrast", token: "--on-accent", ink: "--accent", grouped: true },
  { label: "Text", token: "--accent-text" },
  { label: "Background", token: "--accent-surface" },
  { label: "Border", token: "--accent-border" },
] as const;

const secondary = [
  { label: "Solid", token: "--secondary", ink: "--on-secondary", grouped: true },
  { label: "Contrast", token: "--on-secondary", ink: "--secondary", grouped: true },
  { label: "Text", token: "--secondary-text" },
  { label: "Background", token: "--secondary-surface" },
  { label: "Border", token: "--secondary-border" },
] as const;

const tertiary = [
  { label: "Solid", token: "--tertiary", ink: "--on-tertiary", grouped: true },
  { label: "Contrast", token: "--on-tertiary", ink: "--tertiary", grouped: true },
  { label: "Text", token: "--tertiary-text" },
  { label: "Background", token: "--tertiary-surface" },
  { label: "Border", token: "--tertiary-border" },
] as const;

const feedback = [
  {
    title: "Success",
    items: [
      { label: "Solid", token: "--success", ink: "--on-success", grouped: true },
      { label: "Contrast", token: "--on-success", ink: "--success", grouped: true },
      { label: "Text", token: "--accent-text", accent: "success" },
      { label: "Background", token: "--accent-surface", accent: "success" },
      { label: "Border", token: "--accent-border", accent: "success" },
    ],
  },
  {
    title: "Warning",
    items: [
      { label: "Solid", token: "--warning", ink: "--on-warning", grouped: true },
      { label: "Contrast", token: "--on-warning", ink: "--warning", grouped: true },
      { label: "Text", token: "--accent-text", accent: "warning" },
      { label: "Background", token: "--accent-surface", accent: "warning" },
      { label: "Border", token: "--accent-border", accent: "warning" },
    ],
  },
  {
    title: "Danger",
    items: [
      { label: "Solid", token: "--danger", ink: "--on-danger", grouped: true },
      { label: "Contrast", token: "--on-danger", ink: "--danger", grouped: true },
      { label: "Text", token: "--accent-text", accent: "danger" },
      { label: "Background", token: "--accent-surface", accent: "danger" },
      { label: "Border", token: "--accent-border", accent: "danger" },
    ],
  },
] as const;
---

<Section {...sections.colors}>
  <p slot="summary" class="sg-note">Use semantic roles and paired contrast colors in content. Supported explicit routes are
    <code>secondary</code>, <code>tertiary</code>, <code>success</code>, <code>warning</code>, and <code>danger</code>;
    omit <code>data-accent</code> for the default accent. Palette swatches remain source colors.</p>

  <Specimen id="palette" title="Palette">
    <Swatches label="Fixed light and dark colors" items={palette} />
  </Specimen>

  <Specimen id="theme" title="Theme">
    <Swatches label="Theme colors" items={theme} />
  </Specimen>

  <Specimen id="accent" title="Accent">
    <Swatches label="Accent color family" items={accent} />
  </Specimen>

  <Specimen id="secondary" title="Secondary">
    <Swatches label="Secondary color family" items={secondary} accent="secondary" />
  </Specimen>

  <Specimen id="tertiary" title="Tertiary">
    <Swatches label="Tertiary color family" items={tertiary} accent="tertiary" />
  </Specimen>

  <Specimen id="feedback" title="Feedback">
    <div class="sg-feedback-families">
      {feedback.map((family) => (
        <section>
          <h4>{family.title}</h4>
          <Swatches items={family.items} />
        </section>
      ))}
    </div>
  </Specimen>
</Section>
