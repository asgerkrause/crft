---
import Section from "../components/Section.astro";
import Specimen from "../components/Specimen.astro";
import Swatches from "../components/Swatches.astro";
import { sections } from "../data";

const palette = [
  { label: "Light", token: "--ak-palette-light" },
  { label: "Dark", token: "--ak-palette-dark" },
  { label: "Red", token: "--ak-palette-red" },
  { label: "Orange", token: "--ak-palette-orange" },
  { label: "Yellow", token: "--ak-palette-yellow" },
  { label: "Green", token: "--ak-palette-green" },
  { label: "Blue", token: "--ak-palette-blue" },
  { label: "Purple", token: "--ak-palette-purple" },
] as const;

const theme = [
  { label: "Background", token: "--ak-canvas" },
  { label: "Surface", token: "--ak-surface" },
  { label: "Border", token: "--ak-border" },
  { label: "Foreground", token: "--ak-text" },
  { label: "Muted", token: "--ak-text-muted" },
  { label: "Accent", token: "--ak-accent", ink: "--ak-on-accent" },
  { label: "Secondary", token: "--ak-secondary", ink: "--ak-on-secondary" },
  { label: "Tertiary", token: "--ak-tertiary", ink: "--ak-on-tertiary" },
  { label: "Success", token: "--ak-success", ink: "--ak-on-success" },
  { label: "Warning", token: "--ak-warning", ink: "--ak-on-warning" },
  { label: "Danger", token: "--ak-danger", ink: "--ak-on-danger" },
] as const;

const accent = [
  { label: "Solid", token: "--ak-accent", ink: "--ak-on-accent" },
  { label: "Contrast", token: "--ak-on-accent", ink: "--ak-accent" },
  { label: "Text", token: "--ak-accent-text" },
  { label: "Background", token: "--ak-accent-surface" },
  { label: "Border", token: "--ak-accent-border" },
] as const;

const secondary = [
  { label: "Solid", token: "--ak-secondary", ink: "--ak-on-secondary" },
  { label: "Contrast", token: "--ak-on-secondary", ink: "--ak-secondary" },
  { label: "Text", token: "--ak-secondary-text" },
  { label: "Background", token: "--ak-secondary-surface" },
  { label: "Border", token: "--ak-secondary-border" },
] as const;

const tertiary = [
  { label: "Solid", token: "--ak-tertiary", ink: "--ak-on-tertiary" },
  { label: "Contrast", token: "--ak-on-tertiary", ink: "--ak-tertiary" },
  { label: "Text", token: "--ak-tertiary-text" },
  { label: "Background", token: "--ak-tertiary-surface" },
  { label: "Border", token: "--ak-tertiary-border" },
] as const;

const feedback = [
  {
    title: "Success",
    items: [
      { label: "Solid", token: "--ak-success", ink: "--ak-on-success" },
      { label: "Contrast", token: "--ak-on-success", ink: "--ak-success" },
      { label: "Text", token: "--ak-accent-text", accent: "success" },
      { label: "Background", token: "--ak-accent-surface", accent: "success" },
      { label: "Border", token: "--ak-accent-border", accent: "success" },
    ],
  },
  {
    title: "Warning",
    items: [
      { label: "Solid", token: "--ak-warning", ink: "--ak-on-warning" },
      { label: "Contrast", token: "--ak-on-warning", ink: "--ak-warning" },
      { label: "Text", token: "--ak-accent-text", accent: "warning" },
      { label: "Background", token: "--ak-accent-surface", accent: "warning" },
      { label: "Border", token: "--ak-accent-border", accent: "warning" },
    ],
  },
  {
    title: "Danger",
    items: [
      { label: "Solid", token: "--ak-danger", ink: "--ak-on-danger" },
      { label: "Contrast", token: "--ak-on-danger", ink: "--ak-danger" },
      { label: "Text", token: "--ak-accent-text", accent: "danger" },
      { label: "Background", token: "--ak-accent-surface", accent: "danger" },
      { label: "Border", token: "--ak-accent-border", accent: "danger" },
    ],
  },
] as const;
---

<Section {...sections.colors}>
  <p slot="summary" class="sg-note">Use semantic roles and paired contrast colors in content. Supported explicit routes are
    <code>secondary</code>, <code>tertiary</code>, <code>success</code>, <code>warning</code>, and <code>danger</code>;
    omit <code>data-accent</code> for the default accent. Palette swatches remain source colors.</p>

  <Specimen id="palette" title="Palette">
    <Swatches label="Fixed light and dark colors" items={palette} />
  </Specimen>

  <Specimen id="theme" title="Theme">
    <Swatches label="Theme colors" items={theme} />
  </Specimen>

  <Specimen id="accent" title="Accent">
    <Swatches label="Accent color family" items={accent} />
  </Specimen>

  <Specimen id="secondary" title="Secondary">
    <Swatches label="Secondary color family" items={secondary} accent="secondary" />
  </Specimen>

  <Specimen id="tertiary" title="Tertiary">
    <Swatches label="Tertiary color family" items={tertiary} accent="tertiary" />
  </Specimen>

  <Specimen id="feedback" title="Feedback">
    <div class="sg-feedback-families">
      {feedback.map((family) => (
        <section>
          <h4>{family.title}</h4>
          <Swatches items={family.items} />
        </section>
      ))}
    </div>
  </Specimen>
</Section>
