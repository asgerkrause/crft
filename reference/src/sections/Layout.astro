---
import Section from "../components/Section.astro";
import Specimen from "../components/Specimen.astro";
import { sections } from "../data";
import placeholder from "../assets/placehold.svg";
---
<Section {...sections.layout}>
  <p slot="summary">Containers establish content measure. A stack groups one vertical flow; other arrangements belong to their local semantic owner.</p>
  <Specimen id="containers" title="Containers">
    <div class="sg-width-specimens">
      <div class="c sm"><span>Narrow container</span><code>.c.sm</code></div>
      <div class="c"><span>Default container</span><code>.c</code></div>
      <div class="c lg"><span>Wide container</span><code>.c.lg</code></div>
    </div>
  </Specimen>
  <Specimen id="stacks" title="Stack">
    <div class="sg-stack-sample s"><span>One</span><span>Two</span><span>Three</span></div>
    <p><code>.s</code> consumes <code>--gap</code>. A project owns horizontal actions, alignment, and local spacing.</p>
  </Specimen>
  <Specimen id="image-frame" title="Image frame">
    <figure class="sg-scroll-example">
      <div class="img-w" data-fixture="layout-image-frame"><img alt="" width="1005" height="1005" src={placeholder.src}></div>
      <figcaption><code>.img-w</code> clips the frame. Crop and aspect stay project-owned.</figcaption>
    </figure>
  </Specimen>
</Section>
