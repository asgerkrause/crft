---
import Section from "../components/Section.astro";
import Specimen from "../components/Specimen.astro";
import { sections } from "../data";

const headings = [
  { html: undefined, className: "h0", label: "Heading zero · display heading", display: true },
  { html: "h1", className: "h1", label: "Heading one" },
  { html: "h2", className: "h2", label: "Heading two" },
  { html: "h3", className: "h3", label: "Heading three" },
  { html: "h4", className: "h4", label: "Heading four" },
  { html: "h5", className: "h5", label: "Heading five" },
  { html: "h6", className: "h6", label: "Heading six" },
] as const;

const textRoles = [
  { className: "t-lg", label: "Large text" },
  { className: "t-bd", label: "Body text" },
  { className: "t-sm", label: "Small text" },
] as const;

const families = [
  { token: "--t-ff-sa", className: "f-sa", label: "Sans text" },
  { token: "--t-ff-se", className: "f-se", label: "Serif text" },
  { token: "--t-ff-mo", className: "f-mo", label: "Mono text" },
  { token: "--t-ff-bd", className: "f-bd", label: "Body text" },
  { token: "--t-ff-dp", className: "f-dp", label: "Display text" },
] as const;

const weights = [
  { token: "--t-fw-lt", className: "w-lt", label: "Light text" },
  { token: "--t-fw-rg", className: "w-rg", label: "Regular text" },
  { token: "--t-fw-bd", className: "w-bd", label: "Bold text" },
] as const;
---

<Section {...sections.type}>
  <p slot="summary" class="c-mu">Use semantic headings for document structure and visual roles only when presentation intentionally differs.</p>

  <Specimen id="headings" title="Headings">
    <div class="sg-type-list">
      {headings.map((heading) => (
        <article class:list={["sg-type-row", "s", "h", "sb", { "sg-type-display": heading.display }]}>
          {heading.html ? (
            <span><code class="sg-chip html">{heading.html}</code> <code class="sg-chip class">.{heading.className}</code></span>
          ) : (
            <code class="sg-chip class">.{heading.className}</code>
          )}
          <p class={heading.className}>{heading.label}</p>
        </article>
      ))}
    </div>
  </Specimen>

  <Specimen id="text" title="Text">
    <div class="sg-type-list">
      {textRoles.map((role) => (
        <article class="sg-type-row s h sb">
          <code class="sg-chip class">.{role.className}</code>
          <p class={role.className}>{role.label}</p>
        </article>
      ))}
    </div>
  </Specimen>

  <Specimen id="long-content" title="Long content">
    <article class="s" data-fixture="type-long-content">
      <h4 data-fixture="type-semantic-heading">Semantic headings retain a readable measure when a long sentence needs more than one line to communicate its complete meaning.</h4>
      <p class="t-lg" data-fixture="type-large-text">Large text retains its own readable measure across enough content to wrap naturally without clipping or a project-owned width.</p>
      <p class="t-bd" data-fixture="type-body-text">Body text stays semantic and readable when the content is long enough to reveal the role’s measure, line height, and ordinary wrapping behavior.</p>
      <p class="t-sm" data-fixture="type-small-text">Small text also wraps at its role-owned measure instead of inheriting a component-specific maximum width.</p>
    </article>
  </Specimen>

  <Specimen id="families" title="Families">
    <div class="sg-type-list">
      {families.map((family) => (
        <article class="sg-type-row s h sb">
          <span><code class="sg-chip token">{family.token}</code> <code class="sg-chip class">.{family.className}</code></span>
          <p class={family.className}>{family.label}</p>
        </article>
      ))}
    </div>
  </Specimen>

  <Specimen id="weights" title="Weights">
    <div class="sg-type-list">
      {weights.map((weight) => (
        <article class="sg-type-row s h sb">
          <span><code class="sg-chip token">{weight.token}</code> <code class="sg-chip class">.{weight.className}</code></span>
          <p class:list={["h2", weight.className]}>{weight.label}</p>
        </article>
      ))}
    </div>
  </Specimen>

  <Specimen id="elements" title="Elements">
    <div class="sg-type-list">
      <article class="sg-type-row s h sb"><code class="sg-chip html">mark</code><p class="h2"><mark>Marked text</mark></p></article>
      <article class="sg-type-row s h sb"><span><code class="sg-chip html">strong</code> <code class="sg-chip html">b</code></span><p class="h2"><strong>Strong</strong> and <b>bold</b></p></article>
      <article class="sg-type-row s h sb"><span><code class="sg-chip html">em</code> <code class="sg-chip html">i</code></span><p class="h2"><em>Emphasized</em> and <i>alternate voice</i></p></article>
      <article class="sg-type-row s h sb"><code class="sg-chip html">a</code><p class="h2"><a href="#typography">Linked text</a></p></article>
      <article class="sg-type-row s h sb"><code class="sg-chip html">small</code><p class="h2"><small>Small print</small></p></article>
      <article class="sg-type-row s h sb"><span><code class="sg-chip html">code</code> <code class="sg-chip html">kbd</code> <code class="sg-chip html">samp</code></span><p class="h2"><code>const role = "public"</code> <kbd>⌘ K</kbd> <samp>Ready</samp></p></article>
      <article class="sg-type-row s h sb"><code class="sg-chip html">pre</code><pre><code>section &gt; .c &#123;
  container: container / inline-size;
&#125;</code></pre></article>
      <article class="sg-type-row s h sb"><code class="sg-chip html">blockquote</code><blockquote class="h2"><p>Meaning before hooks.</p><cite>CRFT system strategy</cite></blockquote></article>
      <article class="sg-type-row s h sb"><span><code class="sg-chip html">sub</code> <code class="sg-chip html">sup</code></span><p class="h2">H<sub>2</sub>O · x<sup>2</sup></p></article>
      <article class="sg-type-row s h sb"><code class="sg-chip html">abbr</code><p class="h2"><abbr title="Cascading Style Sheets">CSS</abbr></p></article>
      <article class="sg-type-row s h sb"><span><code class="sg-chip html">del</code> <code class="sg-chip html">ins</code></span><p class="h2"><del>Removed</del> <ins>Inserted</ins></p></article>
    </div>
  </Specimen>
</Section>
