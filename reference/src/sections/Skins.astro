---
import Section from "../components/Section.astro";
import Specimen from "../components/Specimen.astro";
import { sections } from "../data";

const canvasSkins = [
  { skin: "tone", label: "Tone boundary" },
  { skin: "invert", label: "Inverted boundary" },
] as const;

const accentSkins = [
  { accent: undefined, label: "Primary accent boundary", fixture: "skin-accent-primary" },
  { accent: "secondary", label: "Secondary accent boundary", fixture: "skin-accent-secondary" },
  { accent: "tertiary", label: "Tertiary accent boundary", fixture: "skin-accent-tertiary" },
  { accent: "success", label: "Success feedback boundary", fixture: "skin-accent-success" },
  { accent: "warning", label: "Warning feedback boundary", fixture: "skin-accent-warning" },
  { accent: "danger", label: "Danger feedback boundary", fixture: "skin-accent-danger" },
] as const;
---

<Section {...sections.skins}>
  <p slot="summary" class="sg-note">Themes change colors only. Choose light or dark with root <code>color-scheme</code>; leave it unset for system preference.</p>

  <Specimen id="canvas-skins" title="Canvas themes">
    <div class="sg-skin-grid">
      {canvasSkins.map(({ skin, label }) => (
        <article class="sg-skin-card" data-theme={skin}>
          <p>{label}</p><code>{`data-theme="${skin}"`}</code>
        </article>
      ))}
    </div>
  </Specimen>

  <Specimen id="accent-skins" title="Accent themes">
    <div class="sg-skin-grid">
      {accentSkins.map(({ accent, label, fixture }) => (
        <article class="sg-skin-card" data-theme="accent" data-accent={accent} data-fixture={fixture}>
          <p>{label}</p>
          <code>{accent ? `data-theme="accent" data-accent="${accent}"` : `data-theme="accent"`}</code>
        </article>
      ))}
    </div>
  </Specimen>

  <Specimen id="nested-boundaries" title="Nested boundaries">
    <div class="sg-skin-grid">
      <article class="sg-skin-card" data-fixture="skin-nested-outer" data-theme="accent">
        <p>Outer accent boundary</p>
        <div class="sg-skin-card" data-fixture="skin-nested-inner" data-theme="tone">
          <p>Nested tone</p><code>data-theme="tone"</code>
        </div>
      </article>
    </div>
  </Specimen>
</Section>
