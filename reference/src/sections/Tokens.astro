---
import Section from "../components/Section.astro";
import Specimen from "../components/Specimen.astro";
import { sections } from "../data";

interface TokenRow {
  label: string;
  tokens: string;
  chips?: readonly string[];
}

interface TokenGroup {
  id: string;
  title: string;
  rows: readonly TokenRow[];
}

const groups: readonly TokenGroup[] = [
  {
    id: "layout-and-sizing",
    title: "Layout and sizing",
    rows: [
      { label: "Header and controls", tokens: "--l-hh · --l-ch" },
      { label: "Layout", tokens: "--l-vp-min · --l-vp-max · --l-cw · --l-bl-x · --l-bl-y · --l-cq-md · --l-cq-lg" },
      { label: "Spacing", tokens: "--s-rt · --s-xs · --s-sm · --s · --s-lg · --s-xl" },
      { label: "Gap", tokens: "--g-rt · --g-xs · --g-sm · --g · --g-lg · --g-xl" },
      { label: "Padding", tokens: "--p-rt · --p-xs · --p-sm · --p · --p-lg · --p-xl" },
      { label: "Radius", tokens: "--r-rt · --r-xs · --r-sm · --r · --r-lg · --r-xl" },
      { label: "Border and focus", tokens: "--b-wd · --f-wd · --f-of" },
      { label: "Large text", tokens: "--t-lg-lh · --t-lg-ls · --t-lg-fw · --t-lg-tt · --t-lg-mw" },
      { label: "Body text", tokens: "--t-bd-lh · --t-bd-ls · --t-bd-fw · --t-bd-tt · --t-bd-mw" },
      { label: "Small text", tokens: "--t-sm-lh · --t-sm-ls · --t-sm-fw · --t-sm-tt · --t-sm-mw" },
    ],
  },
  {
    id: "typography-tokens",
    title: "Typography",
    rows: [
      { label: "Fonts", tokens: "--t-ff-sa · --t-ff-se · --t-ff-mo · --t-ff-bd · --t-ff-dp" },
      { label: "Weights", tokens: "--t-fw-lt · --t-fw-rg · --t-fw-bd" },
      { label: "Fluid type", tokens: "--t-fs-min · --t-fs-max · --t-rt-min · --t-rt-max" },
      { label: "Heading zero", tokens: "--t-h0-lh · --t-h0-ls · --t-h0-fw · --t-h0-tt · --t-h0-mw" },
      { label: "Heading one", tokens: "--t-h1-lh · --t-h1-ls · --t-h1-fw · --t-h1-tt · --t-h1-mw" },
      { label: "Heading two", tokens: "--t-h2-lh · --t-h2-ls · --t-h2-fw · --t-h2-tt · --t-h2-mw" },
      { label: "Heading three", tokens: "--t-h3-lh · --t-h3-ls · --t-h3-fw · --t-h3-tt · --t-h3-mw" },
      { label: "Heading four", tokens: "--t-h4-lh · --t-h4-ls · --t-h4-fw · --t-h4-tt · --t-h4-mw" },
      { label: "Heading five", tokens: "--t-h5-lh · --t-h5-ls · --t-h5-fw · --t-h5-tt · --t-h5-mw" },
      { label: "Heading six", tokens: "--t-h6-lh · --t-h6-ls · --t-h6-fw · --t-h6-tt · --t-h6-mw" },
    ],
  },
  {
    id: "color-tokens",
    title: "Color",
    rows: [
      { label: "Palette", tokens: "--c-sw-red · --c-sw-ora · --c-sw-yel · --c-sw-lim · --c-sw-gre · --c-sw-cya · --c-sw-sky · --c-sw-blu · --c-sw-pur · --c-sw-pin · --c-sw-mag · --c-sw-li · --c-sw-da" },
      {
        label: "Semantic color",
        tokens: "",
        chips: [
          "--c-ac", "--c-sc", "--c-tr", "--c-ac-co", "--c-sc-co", "--c-tr-co", "--c-ac-bg",
          "--c-sc-bg", "--c-tr-bg", "--c-ac-fg", "--c-sc-fg", "--c-tr-fg", "--c-ac-bc", "--c-sc-bc",
          "--c-tr-bc", "--c-fb-su", "--c-fb-wn", "--c-fb-dn", "--c-fb-su-co", "--c-fb-wn-co", "--c-fb-dn-co",
        ],
      },
      { label: "Surface color", tokens: "--c-bg-base · --c-fg-base · --c-bg · --c-fg · --c-sf · --c-bc · --c-mu · --c-tn · --c-sm" },
    ],
  },
  {
    id: "motion-tokens",
    title: "Motion",
    rows: [
      { label: "Motion", tokens: "--m-tf-i · --m-tf-o · --m-tf-io · --m-tf-g · --m-tf-s · --m-td-sf · --m-td-f · --m-td · --m-td-s · --m-td-ss" },
      { label: "Lift", tokens: "--m-lift" },
      { label: "View transitions", tokens: "--m-vt-blur · --m-vt-i-y · --m-vt-i-x · --m-vt-o-y · --m-vt-o-x · --m-vt-d" },
    ],
  },
] as const;
---

<Section {...sections.tokens}>
  <p slot="summary" t="mu">This catalog names the public API only. Refer to the token source for values and
    derivations.</p>

  {groups.map((group) => (
    <Specimen id={group.id} title={group.title}>
      <div class="sg-type-list">
        {group.rows.map((row) => (
          <div class="sg-type-row" s="h sb">
            <p class="sg-specimen-meta"><span>{row.label}</span></p>
            <p>
              {row.chips
                ? row.chips.map((token) => <code class="sg-chip token">{token}</code>)
                : <code>{row.tokens}</code>}
            </p>
          </div>
        ))}
      </div>
    </Specimen>
  ))}
</Section>
