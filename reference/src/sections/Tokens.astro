---
import source from "../../../styles/tokens.css?raw";
import Section from "../components/Section.astro";
import { sections } from "../data";
const names = [...new Set([...source.matchAll(/(--[a-z][a-z0-9-]*)\s*:/g)].map((match) => match[1]))].sort();
---
<Section {...sections.tokens}>
  <p slot="summary">Exact public names from the live owner. The handbook documents every job; CSS owns values and recipes.</p>
  <ul class="sg-token-index">{names.map((name) => <li><code>{name}</code></li>)}</ul>
</Section>
