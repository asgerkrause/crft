---
import Section from "../components/Section.astro";
import Specimen from "../components/Specimen.astro";
import { sections } from "../data";
import placeholder from "../assets/placehold.svg";
---

<Section {...sections.motion}>
  <p slot="summary" class="sg-note">Opt-in motion keeps a complete static result and respects reduced-motion preferences.</p>

  <Specimen id="disclosure" title="Disclosure">
    <details open data-fixture="progressive-disclosure">
      <summary>Disclosure animation</summary>
      <p>When supported, native details content animates with motion roles. The closed and open states remain native without support.</p>
    </details>
  </Specimen>

  <Specimen id="motion-roles" title="Motion roles">
    <div class="s sg-motion-groups" data-fixture="reduced-motion">
      <div class="sg-motion-controls" hidden>
      <fieldset class="sg-motion-speed">
        <legend>Preview duration</legend>
        <div>
          <label><input class="sr" type="radio" name="motion-speed" value="shortest">Shortest <code>--duration-xs</code></label>
          <label><input class="sr" type="radio" name="motion-speed" value="fast">Fast <code>--duration-sm</code></label>
          <label><input class="sr" type="radio" name="motion-speed" value="default">Default <code>--duration</code></label>
          <label><input class="sr" type="radio" name="motion-speed" value="slow">Slow <code>--duration-lg</code></label>
          <label><input class="sr" type="radio" name="motion-speed" value="slowest" checked>Slowest <code>--duration-xl</code></label>
        </div>
      </fieldset>
      <button type="button" class="sg-motion-replay">Replay from start</button>
      </div>
      <div class="sg-motion-list">
        <div class="sg-motion-demo" style="--sg-motion-ease:var(--ease-in)">
          <div class="sg-motion-track" aria-hidden="true"><i></i></div><span>In</span><code>--ease-in</code>
        </div>
        <div class="sg-motion-demo" style="--sg-motion-ease:var(--ease-in-out)">
          <div class="sg-motion-track" aria-hidden="true"><i></i></div><span>In-out</span><code>--ease-in-out</code>
        </div>
        <div class="sg-motion-demo" style="--sg-motion-ease:var(--ease-out)">
          <div class="sg-motion-track" aria-hidden="true"><i></i></div><span>Out</span><code>--ease-out</code>
        </div>
        <div class="sg-motion-demo" style="--sg-motion-ease:var(--ease-glide)">
          <div class="sg-motion-track" aria-hidden="true"><i></i></div><span>Glide</span><code>--ease-glide</code>
        </div>
        <div class="sg-motion-demo" style="--sg-motion-ease:var(--ease-spring)">
          <div class="sg-motion-track" aria-hidden="true"><i></i></div><span>Spring</span><code>--ease-spring</code>
        </div>
      </div>
    </div>
    <p class="small">Each replay starts all five bars together, reaches the same marker in the selected duration, then rests. Space beyond the marker keeps spring overshoot visible. Replaying starts a fresh comparison. Reduced motion and the static fallback show the same endpoint.</p>
  </Specimen>

  <Specimen id="scroll-linked-motion" title="Scroll-linked motion">
    <p class="small">The frame stays fixed. The image is taller by its travel distance, keeping the crop covered in both directions. Reduced motion keeps a static crop.</p>
    <div g="2">
      <figure class="sg-scroll-example">
        <div class="img-w" data-scrub data-fixture="progressive-scroll-default"><img alt="" width="1005" height="1005" src={placeholder.src}></div>
        <figcaption>Default <code>.img-w[data-scrub]</code></figcaption>
      </figure>
      <figure class="sg-scroll-example">
        <div class="img-w" data-scrub="reverse" data-fixture="progressive-scroll-reverse"><img alt="" width="1005" height="1005" src={placeholder.src}></div>
        <figcaption>Reverse <code>data-scrub="reverse"</code></figcaption>
      </figure>
    </div>
  </Specimen>

  <Specimen id="view-transitions" title="View transitions">
    <p>Supported browsers animate same-origin navigation of <code>main</code> with <code>--transition-*</code>. Header and footer keep their names. Reduced motion removes the animation.</p>
  </Specimen>
</Section>

<script>
  const comparison = document.querySelector<HTMLElement>(".sg-motion-groups");
  const controls = comparison?.querySelector<HTMLElement>(".sg-motion-controls");
  const replay = comparison?.querySelector<HTMLButtonElement>(".sg-motion-replay");
  if (comparison && controls && replay) {
    const bars = Array.from(comparison.querySelectorAll<HTMLElement>(".sg-motion-track > i"));
    const preference = matchMedia("(prefers-reduced-motion: reduce)");
    let animations: Animation[] = [];
    function stop() {
      animations.forEach((animation) => animation.cancel());
      animations = [];
    }
    replay.addEventListener("click", () => {
      stop();
      if (preference.matches) return;
      // Replay is an explicit timing specimen, including keyboard activation.
      const start = document.timeline.currentTime;
      animations = bars.map((bar) => {
        const style = getComputedStyle(bar);
        const time = style.getPropertyValue("--sg-motion-preview-duration").trim();
        const animation = bar.animate([{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }], {
          duration: parseFloat(time) * (time.endsWith("ms") ? 1 : 1000),
          easing: style.getPropertyValue("--sg-motion-ease").trim(),
        });
        animation.startTime = start;
        return animation;
      });
    });
    controls.addEventListener("change", stop);
    preference.addEventListener("change", stop);
    window.addEventListener("pagehide", stop);
    controls.hidden = false;
  }
</script>
