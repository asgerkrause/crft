---
interface Props {
  id: string;
  heading: string;
  summary: string;
  actionLabel: string;
  actionHref: string;
}

const { id, heading, summary, actionLabel, actionHref } = Astro.props;
---

<section id={id} data-theme="accent">
  <div class="c sm">
    <div class="s cta">
      <h2 class="h1">{heading}</h2>
      <p class="lead">{summary}</p>
      <p><a href={actionHref}>{actionLabel}</a></p>
    </div>
  </div>
</section>

<style>
  @layer project {
    .cta {
      padding-block: var(--ak-space-md);
      text-align: start;

      a {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--ak-control-height);
        max-inline-size: 100%;
        padding: var(--ak-padding-sm) var(--ak-padding-md);
        border: var(--ak-border-width) solid var(--ak-text);
        border-radius: var(--ak-radius-sm);
        background: var(--ak-text);
        color: var(--ak-canvas);

        text-decoration: none;

        &:hover { background: var(--ak-accent); color: var(--ak-on-accent); }
        &:focus-visible { outline: 2px solid var(--ak-text); outline-offset: 3px; }
      }
    }
  }
</style>
