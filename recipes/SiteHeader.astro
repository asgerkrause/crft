---
interface Link {
  label: string;
  href: string;
}

interface Props {
  name: string;
  homeHref: string;
  links: Link[];
}

const { name, homeHref, links } = Astro.props;
---

<header class="site">
  <a class="brand" href={homeHref}>{name}</a>
  <nav aria-label="Primary">
    <ul>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  @layer project {
    .site {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--gap) var(--space);
      padding-block: var(--padding);
      border-bottom: var(--border-width) solid var(--border);
    }

    .brand {
      font-family: var(--font-serif);
      font-size: var(--h3-size);
      color: inherit;
      text-decoration: none;
    }

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--gap-xs) var(--gap);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    a {
      display: inline-flex;
      align-items: center;
      min-block-size: var(--control);
      color: inherit;
      text-underline-offset: .18em;

      &:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    }
  }
</style>
